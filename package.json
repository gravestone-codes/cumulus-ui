{
  "name": "cumulus-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:api": "pnpm --filter @cumulus/api dev",
    "dev:ui": "pnpm --filter @cumulus/ui dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check .",
    "codegen": "pnpm --filter @cumulus/spec codegen",
    "manifest": "pnpm --filter @cumulus/spec manifest"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript-eslint": "8.70.0"
  }
}
